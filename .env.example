# ============================================================
#  Pixel Starships Discord Bot — configuration
#  Copy this file to ".env" and fill in the values.
# ============================================================

# REQUIRED — your Discord bot token
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=

# OPTIONAL — restrict slash-command sync to a single guild (server) for
# instant updates while developing. Leave empty for global commands
# (global commands can take up to ~1h to appear the first time).
DISCORD_GUILD_ID=

# OPTIONAL — Pixel Starships API host (rarely needs changing)
PSS_API_HOST=api.pixelstarships.com

# OPTIONAL — language for game data (en, fr, de, es, ...)
PSS_LANGUAGE=en

# OPTIONAL — device-login checksum key.
# The public PSS API exposes most data (players, fleets, crew, items,
# daily offers) WITHOUT any key. A few endpoints (player ladder,
# fleet details/members, ship inspection, marketplace) require an
# authenticated device token. If you have the community checksum key,
# set it here to unlock those extra commands. Leave empty otherwise —
# the bot runs fine without it and simply hides the locked commands.
PSS_DEVICE_CHECKSUM_KEY=
