[Unit]
Description=PSS Companion website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/BOTTESTE
EnvironmentFile=-/home/ubuntu/BOTTESTE/.env
ExecStart=/home/ubuntu/BOTTESTE/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8300
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
